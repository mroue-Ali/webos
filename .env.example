# Copy to .env and fill in. Never commit .env.

# Long random secret. Signs session cookies and encrypts the stored TOTP secret.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WEBOS_SECRET_KEY=

# The exact address(es) you open the panel at, comma-separated. State-changing requests
# from any other origin are refused. Through an SSH tunnel this is http://localhost:9000.
WEBOS_ALLOWED_ORIGINS=http://localhost:9000

# Host user the container runs as (see `id -u` / `id -g`). Must own ./data.
WEBOS_UID=1001
WEBOS_GID=1001

# Loopback port the panel listens on.
# WEBOS_PORT=9000

# Session lengths.
# WEBOS_SESSION_IDLE_MINUTES=30
# WEBOS_SESSION_MAX_HOURS=12

# Only set to false for a plain-HTTP address that isn't localhost.
# WEBOS_COOKIE_SECURE=true
