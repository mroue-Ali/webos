# Copy to .env and fill in. Never commit .env.

# Long random secret. Signs session cookies and encrypts the stored TOTP secret.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WEBOS_SECRET_KEY=

# The exact address(es) you open the panel at, comma-separated. State-changing requests
# from any other origin are refused. Through an SSH tunnel this is http://localhost:9000.
WEBOS_ALLOWED_ORIGINS=http://localhost:9000

# Host user the container runs as (see `id -u` / `id -g`). Must own ./data.
WEBOS_UID=1001
WEBOS_GID=1001

# Loopback port the panel listens on.
# WEBOS_PORT=9000

# Behind host nginx on a public subdomain (deploy/nginx-site.conf): add its https origin
# above, and trust nginx's X-Forwarded-For so the login throttle sees real client IPs.
# Requests from host nginx reach the container from Docker's bridge gateway (172.16/12).
# WEBOS_ALLOWED_ORIGINS=https://webos.example.com,http://localhost:9000
# WEBOS_FORWARDED_ALLOW_IPS=172.16.0.0/12

# Session lengths.
# WEBOS_SESSION_IDLE_MINUTES=30
# WEBOS_SESSION_MAX_HOURS=12

# Only set to false for a plain-HTTP address that isn't localhost.
# WEBOS_COOKIE_SECURE=true

# Deploying sites (needs webos-agent: sudo sh agent/install.sh prints this number).
# WEBOS_AGENT_GID=
# Offered as <name>.<base domain> in the new-site wizard.
# WEBOS_BASE_DOMAIN=example.com
